    },
    {
      "id": "water_bare_hbonds",
      "system_class": "water-box-with-hbonds",
      "use": "water/PME comparison",
      "archive": "water_bare_hbonds.tar.gz"
    },
    {
      "id": "rnase_bench_systems",
      "system_class": "rnase",
      "use": "protein/PME comparison",
      "archive": "rnase_bench_systems.tar.gz"
    },
    {
      "id": "gmxbench-3.0",
      "system_class": "mixed-benchmark-suite",
      "use": "cross-system comparison",
      "archive": "gmxbench-3.0.tar.gz"
    },
    {
      "id": "villin_vsites",
      "system_class": "villin",
